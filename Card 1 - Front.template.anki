<!-- FRONT CARD TEMPLATE
     - Tags are hidden on the front to prevent unwarranted hints.
     - Employs strict, nested Anki conditional blocks so that audio fields are completely
       absent from the DOM on standard reading cards, preventing accidental autoplay.
     - Displays ONLY the Sentence (or Expression fallback) on standard cards.
     - Displays ONLY the Sentence Audio (or Word Audio fallback) on listening cards (both definitions empty).
-->

<div class="card-wrapper">
  <div class="card-container">

    <!-- STANDARD VIEW (If 'Definition' is present) -->
    {{#Definition}}
      <div class="standard-view">
        <div class="sentence-display">
          {{#Sentence}}
            {{Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{Expression}}
          {{/Sentence}}
        </div>
      </div>
    {{/Definition}}

    <!-- STANDARD VIEW (If 'Definition' is empty BUT 'Extended definition' is present) -->
    {{^Definition}}
      {{#Extended definition}}
        <div class="standard-view">
          <div class="sentence-display">
            {{#Sentence}}
              {{Sentence}}
            {{/Sentence}}
            {{^Sentence}}
              {{Expression}}
            {{/Sentence}}
          </div>
        </div>
      {{/Extended definition}}
    {{/Definition}}

    <!-- LISTENING VIEW (If BOTH 'Definition' and 'Extended definition' are empty)
         Contains the only instance of Front audio, preventing standard cards from autoplaying.
    -->
    {{^Definition}}
      {{^Extended definition}}
        <div class="listening-view">
          <div class="audio-display">
            {{#Sentence Audio}}
              <div class="audio-group">
                <span class="audio-item">
                  <span class="audio-label">Listen:</span> {{Sentence Audio}}
                </span>
              </div>
            {{/Sentence Audio}}
            
            {{^Sentence Audio}}
              {{#Word Audio}}
                <div class="audio-group">
                  <span class="audio-item">
                    <span class="audio-label">Listen:</span> {{Word Audio}}
                  </span>
                </div>
              {{/Word Audio}}
              
              {{^Word Audio}}
                <!-- Extreme fallback if no audio is available for the listening card -->
                <div class="no-audio-fallback">
                  {{#Sentence}}{{Sentence}}{{/Sentence}}
                  {{^Sentence}}{{Expression}}{{/Sentence}}
                </div>
              {{/Word Audio}}
            {{/Sentence Audio}}
          </div>
          <div class="listening-hint">Listening Card</div>
        </div>
      {{/Extended definition}}
    {{/Definition}}

  </div>
</div>
