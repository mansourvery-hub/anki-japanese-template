<!-- FRONT CARD TEMPLATE
     Minimalist & Focused Study View.
     Dynamically switches to 'Listening Mode' when definitions are absent.
-->

<div class="card-wrapper">
  <div class="card-container">

    <!-- Standard Study View: Triggered if any definition is present -->
    {{#Definition}}
      <div class="sentence-display">
        {{#Sentence}}
          {{Sentence}}
        {{/Sentence}}
        {{^Sentence}}
          {{Expression}}
        {{/Sentence}}
      </div>
    {{/Definition}}

    <!-- Fallback Standard View for Extended Definition -->
    {{^Definition}}
      {{#Extended definition}}
        <div class="sentence-display">
          {{#Sentence}}
            {{Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{Expression}}
          {{/Sentence}}
        </div>
      {{/Extended definition}}
    {{/Definition}}

    <!-- Listening Mode: Triggered if BOTH definitions are missing -->
    {{^Definition}}
      {{^Extended definition}}
        <div class="listening-view">
          <div class="audio-pulse">🎧</div>
          
          <div class="audio-controls">
            {{#Sentence Audio}}
              <div class="audio-item">
                {{Sentence Audio}}
              </div>
            {{/Sentence Audio}}
            
            {{^Sentence Audio}}
              {{#Word Audio}}
                <div class="audio-item">
                  {{Word Audio}}
                </div>
              {{/Word Audio}}
              
              {{^Word Audio}}
                <div class="sentence-display" style="font-size: 1.5rem; opacity: 0.4;">
                  (No Audio Source Found)
                </div>
              {{/Word Audio}}
            {{/Sentence Audio}}
          </div>

          <div style="margin-top: 40px; font-weight: 800; letter-spacing: 0.3em; color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase;">
            Listening Card Active
          </div>
        </div>
      {{/Extended definition}}
    {{/Definition}}

  </div>
</div>
