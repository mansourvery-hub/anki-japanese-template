<!-- v1.8.35 minimal front
     Rung1 shape: plain sentence / expression display, zero fetch, zero listening views, zero visibility: hidden / timers, zero JavaScript.
-->
<div class="card-wrapper">
  <div class="card-container">
    <div class="sentence-display">
      {{#Sentence}}
        {{Sentence}}
      {{/Sentence}}
      {{^Sentence}}
        {{Expression}}
      {{/Sentence}}
    </div>
  </div>
</div>
