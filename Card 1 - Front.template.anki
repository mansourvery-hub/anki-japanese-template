<!-- FRONT CARD TEMPLATE
     Minimalist & Focused Study View.
     Dynamically switches to 'Listening Mode' when definitions are absent.
-->

<div class="card-wrapper">
  <div class="card-container">

  <!-- Standard Study View: Triggered if any definition is present -->
     {{#Definition}}
        <div class="sentence-display">
          {{#Sentence}}
            {{edit:Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{edit:Expression}}
          {{/Sentence}}
        </div>
     {{/Definition}}

     <!-- Fallback Standard View for Extended Definition -->
     {{^Definition}}
       {{#Extended definition}}
         <div class="sentence-display">
           {{#Sentence}}
             {{edit:Sentence}}
           {{/Sentence}}
           {{^Sentence}}
             {{edit:Expression}}
           {{/Sentence}}
         </div>
       {{/Extended definition}}
     {{/Definition}}

     <!-- Listening Mode: Triggered if BOTH definitions are missing -->
     {{^Definition}}
       {{^Extended definition}}
         <div class="listening-view">
           <div class="audio-pulse">🎧</div>
         
           <div class="audio-controls">
             {{#Sentence Audio}}
               <div class="audio-item">
                 {{Sentence Audio}}
               </div>
             {{/Sentence Audio}}
           
             {{^Sentence Audio}}
               {{#Word Audio}}
                 <div class="audio-item">
                   {{Word Audio}}
                 </div>
               {{/Word Audio}}
             
               {{^Word Audio}}
                 <div class="sentence-display no-audio-fallback">
                   (No Audio Source Found)
                 </div>
               {{/Word Audio}}
             {{/Sentence Audio}}
           </div>

           <div class="listening-label">
             Listening Card Active
           </div>
         </div>
       {{/Extended definition}}
     {{/Definition}}

  </div>
</div>
