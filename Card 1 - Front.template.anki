<!-- FRONT CARD TEMPLATE
     Displays the primary study content (Sentence or Expression) for standard cards.
     Switches to an audio-focused view for listening cards when definitions are missing.
     Typography scales dynamically to ensure high visibility across all screen sizes.
-->

<div class="card-wrapper">
  <div class="card-container">

    <!-- Standard Study View -->
    {{#Definition}}
      <div class="standard-view">
        <div class="sentence-display">
          {{#Sentence}}
            {{Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{Expression}}
          {{/Sentence}}
        </div>
      </div>
    {{/Definition}}

    <!-- Standard Study View (Extended definition fallback) -->
    {{^Definition}}
      {{#Extended definition}}
        <div class="standard-view">
          <div class="sentence-display">
            {{#Sentence}}
              {{Sentence}}
            {{/Sentence}}
            {{^Sentence}}
              {{Expression}}
            {{/Sentence}}
          </div>
        </div>
      {{/Extended definition}}
    {{/Definition}}

    <!-- Listening Mode (Definitions are absent) -->
    {{^Definition}}
      {{^Extended definition}}
        <div class="listening-view">
          <div class="audio-display">
            {{#Sentence Audio}}
              <div class="audio-group">
                <span class="audio-item">
                  <span class="audio-label">Listen:</span> {{Sentence Audio}}
                </span>
              </div>
            {{/Sentence Audio}}
            
            {{^Sentence Audio}}
              {{#Word Audio}}
                <div class="audio-group">
                  <span class="audio-label">Listen:</span> {{Word Audio}}
                </span>
              </div>
            {{/Word Audio}}
            
            {{^Word Audio}}
              <div class="no-audio-fallback">
                {{#Sentence}}{{Sentence}}{{/Sentence}}
                {{^Sentence}}{{Expression}}{{/Sentence}}
              </div>
            {{/Word Audio}}
          {{/Sentence Audio}}
        </div>
        <div class="listening-hint">Listening Card</div>
      </div>
      {{/Extended definition}}
    {{/Definition}}

  </div>
</div>
