<!-- FRONT CARD TEMPLATE
     Premium Ergonomic Japanese Front Card
     
     Behavior:
     - Standard: Shows Sentence (or Expression) if Definition / Extended definition exists.
     - Listening: Shows circular interactive audio player if definitions are missing.
     - Fallback: Shows Sentence / Expression if both definitions and audio are missing.
     - Dynamic Font Auto-Scaling: Automatically enlarges short sentences/expressions to fill the viewport.
-->

<div class="card-wrapper">
  <div class="card-container" style="visibility: hidden;">
    <!-- Mature-Card Word Mode probe: shown instead of sentence when interval >= threshold -->
    <div class="front-word-display">{{edit:Expression}}</div>

    <!-- Standard Study View -->
    {{#Definition}}
      <div class="sentence-display">
        {{#Sentence}}
          {{edit:Sentence}}
        {{/Sentence}}
        {{^Sentence}}
          {{edit:Expression}}
        {{/Sentence}}
      </div>
    {{/Definition}}

    <!-- Fallback Standard View (When only Extended definition is present) -->
    {{^Definition}}
      {{#Extended definition}}
        <div class="sentence-display">
          {{#Sentence}}
            {{edit:Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{edit:Expression}}
          {{/Sentence}}
        </div>
      {{/Extended definition}}
    {{/Definition}}

    <!-- Listening Mode / Pathological Fallback -->
    {{^Definition}}
      {{^Extended definition}}
        
        <!-- Sentence Audio available -->
        {{#Sentence Audio}}
          <div class="listening-view">
            <div class="audio-btn-wrapper">
              <button type="button" class="circular-audio-btn large-audio-btn" title="Play Sentence Audio" aria-label="Play sentence audio" onclick="playCircularAudio(this)">
                <svg class="audio-progress-ring" viewBox="0 0 80 80">
                  <circle class="ring-bg" cx="40" cy="40" r="36" />
                  <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                </svg>
                <div class="audio-btn-content">
                  <span class="audio-btn-label">文</span>
                </div>
                <div class="raw-audio-source" style="display:none;">{{Sentence Audio}}</div>
              </button>
            </div>
          </div>
        {{/Sentence Audio}}

        <!-- Word Audio available (Sentence Audio missing) -->
        {{^Sentence Audio}}
          {{#Word Audio}}
            <div class="listening-view">
              <div class="audio-btn-wrapper">
                <button type="button" class="circular-audio-btn large-audio-btn" title="Play Word Audio" aria-label="Play word audio" onclick="playCircularAudio(this)">
                  <svg class="audio-progress-ring" viewBox="0 0 80 80">
                    <circle class="ring-bg" cx="40" cy="40" r="36" />
                    <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                  </svg>
                  <div class="audio-btn-content">
                    <span class="audio-btn-label">言葉</span>
                  </div>
                  <div class="raw-audio-source" style="display:none;">{{Word Audio}}</div>
                </button>
              </div>
            </div>
          {{/Word Audio}}
        {{/Sentence Audio}}

        <!-- Bulletproof Fallback: Neither definition NOR audio exists -->
        {{^Sentence Audio}}
          {{^Word Audio}}
            <div class="sentence-display">
              {{#Sentence}}
                {{edit:Sentence}}
              {{/Sentence}}
              {{^Sentence}}
                {{edit:Expression}}
              {{/Sentence}}
            </div>
          {{/Word Audio}}
        {{/Sentence Audio}}

      {{/Extended definition}}
    {{/Definition}}

  </div>
</div>

<script>
  (async function() {
    const LONG_INTERVAL_DAYS = 365;

    /* Dynamic Font Scaling for Front Sentence / Expression */
    function autoScaleFrontText() {
      const displays = document.querySelectorAll('.sentence-display, .front-word-display');
      displays.forEach(el => {
        const text = el.innerText ? el.innerText.trim() : '';
        const len = text.length;
        if (len === 0) return;

        if (len <= 8) {
          el.style.fontSize = 'clamp(3.8rem, 10vw, 6.8rem)';
          el.style.lineHeight = '1.2';
        } else if (len <= 18) {
          el.style.fontSize = 'clamp(2.8rem, 7vw, 5rem)';
          el.style.lineHeight = '1.3';
        } else if (len <= 35) {
          el.style.fontSize = 'clamp(2.2rem, 5vw, 3.8rem)';
          el.style.lineHeight = '1.4';
        } else {
          el.style.fontSize = 'clamp(1.8rem, 3.8vw, 2.8rem)';
          el.style.lineHeight = '1.45';
        }
      });
    }

    const container = document.querySelector('.card-container');
    const wrapper = document.querySelector('.card-wrapper');
    if (container && wrapper) {
      let wordMode = false;
      try {
        /* 1. AnkiDroid JS API check */
        if (typeof AnkiDroidJS !== 'undefined') {
          const api = new AnkiDroidJS({ version: "0.0.3", developer: "template@example.com" });
          const res = await api.ankiGetCardInterval();
          if (res && res.success && typeof res.value === 'number' && res.value >= LONG_INTERVAL_DAYS) {
            wordMode = true;
          }
        } 
        /* 2. Desktop AnkiConnect check (reads cardId from URL) */
        else {
          const urlParams = new URLSearchParams(window.location.search);
          const cardId = urlParams.get('card');
          if (cardId) {
            const response = await fetch('http://127.0.0.1:8765', {
              method: 'POST',
              body: JSON.stringify({
                action: 'getCardsInfo',
                version: 6,
                params: { cards: [cardId] }
              })
            });
            const data = await response.json();
            if (data.result && data.result[0] && data.result[0].ivl >= LONG_INTERVAL_DAYS) {
              wordMode = true;
            }
          }
        }
      } catch (e) {
        console.warn('Interval retrieval failed, falling back to sentence view.', e);
      }

      if (wordMode) {
        wrapper.classList.add('word-mode');
      }
      container.style.visibility = 'visible';
      autoScaleFrontText();
    }

    /* Circular Audio Player */
    window.currentActiveAudio = window.currentActiveAudio || null;
    window.currentActiveBtn = window.currentActiveBtn || null;

    window.resetAudioState = function() {
        if (window.currentActiveAudio) {
            window.currentActiveAudio.pause();
            window.currentActiveAudio = null;
        }
        if (window.currentActiveBtn) {
            window.currentActiveBtn.classList.remove('is-playing');
            const ring = window.currentActiveBtn.querySelector('.ring-fill');
            if (ring) {
                const circ = parseFloat(ring.getAttribute('stroke-dasharray')) || 226.19;
                ring.style.strokeDashoffset = circ;
            }
            window.currentActiveBtn = null;
        }
    };

    window.playCircularAudio = function(btn) {
        window.resetAudioState();
        const ringFill = btn.querySelector('.ring-fill');
        const circumference = ringFill ? parseFloat(ringFill.getAttribute('stroke-dasharray')) : 226.19;

        const rawDiv = btn.querySelector('.raw-audio-source');
        let audioSrc = '';
        if (rawDiv) {
            /* Robust regex: [^"'>\]]+ allows spaces, ] terminates sound: */
            const match = rawDiv.innerHTML.match(/(?:src=["']|sound:)([^"'>\]]+)/i);
            if (match) audioSrc = match[1];
        }

        const nativeReplay = btn.querySelector('.replaybutton, .replay-button, a.sound, .soundLink');
        if (!audioSrc) {
            if (nativeReplay) nativeReplay.click();
            return;
        }

        const audio = new Audio(audioSrc);
        window.currentActiveAudio = audio;
        window.currentActiveBtn = btn;
        btn.classList.add('is-playing');

        audio.play().catch(() => {
            window.resetAudioState();
            if (nativeReplay) nativeReplay.click();
        });

        audio.onended = audio.onabort = audio.onerror = () => {
            if (window.currentActiveAudio === audio) {
                window.resetAudioState();
            }
        };

        const updateProgress = () => {
            if (window.currentActiveAudio === audio && !audio.paused && audio.duration) {
                const progress = audio.currentTime / audio.duration;
                ringFill.style.strokeDashoffset = circumference * (1 - Math.min(Math.max(progress, 0), 1));
                requestAnimationFrame(updateProgress);
            }
        };
        requestAnimationFrame(updateProgress);
    };
  })();
</script>
