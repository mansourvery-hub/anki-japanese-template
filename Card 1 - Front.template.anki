<!-- FRONT CARD TEMPLATE
     Premium Ergonomic Japanese Front Card
     
      Behavior:
      - Standard: Shows Sentence (or Expression) if Definition / Extended definition exists.
      - Listening: Shows circular interactive audio player if definitions are missing.
      - Fallback: Shows Sentence / Expression if both definitions and audio are missing.
      - Mature Word Mode: If the card interval >= LONG_INTERVAL_DAYS (script constant),
        the front shows only the Expression instead of the sentence (anti-overlearning).
         Interval is read at review time: AnkiDroid JS API (ankiGetCardInterval) on mobile,
         AnkiConnect on desktop — guiCurrentCard during active review, with a content
         search fallback (Expression field) for the Browse previewer where no review
         is active. Mobile preview screens have no JS bridge (only the reviewer
         injects js-api.js), so they always fall back to the sentence front.
         Any failure falls back to the normal sentence front.
      - Dynamic Font Auto-Scaling: Automatically enlarges short sentences/expressions to fill the viewport.

-->

<div class="card-wrapper">
  <div class="card-container" data-notetype="{{Type}}" style="visibility: hidden;">
    <!-- Mature-Card Word Mode probe: shown instead of sentence when interval >= threshold -->
    <div class="front-word-display">{{edit:Expression}}</div>

    <!-- Standard Study View -->
    {{#Definition}}
      <div class="sentence-display">
        {{#Sentence}}
          {{edit:Sentence}}
        {{/Sentence}}
        {{^Sentence}}
          {{edit:Expression}}
        {{/Sentence}}
      </div>
    {{/Definition}}

    <!-- Fallback Standard View (When only Extended definition is present) -->
    {{^Definition}}
      {{#Extended definition}}
        <div class="sentence-display">
          {{#Sentence}}
            {{edit:Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{edit:Expression}}
          {{/Sentence}}
        </div>
      {{/Extended definition}}
    {{/Definition}}

    <!-- Listening Mode / Pathological Fallback -->
    {{^Definition}}
      {{^Extended definition}}
        
        <!-- Sentence Audio available -->
        {{#Sentence Audio}}
          <div class="listening-view">
            <div class="audio-btn-wrapper">
              <button type="button" class="circular-audio-btn large-audio-btn" title="Play Sentence Audio" aria-label="Play sentence audio" onclick="playCircularAudio(this)">
                <svg class="audio-progress-ring" viewBox="0 0 80 80">
                  <circle class="ring-bg" cx="40" cy="40" r="36" />
                  <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                </svg>
                <span class="audio-btn-content">
                  <span class="audio-btn-label">文</span>
                </span>
              </button>
              <span class="raw-audio-source" aria-hidden="true">{{Sentence Audio}}</span>
            </div>
          </div>
        {{/Sentence Audio}}

        <!-- Word Audio available (Sentence Audio missing) -->
        {{^Sentence Audio}}
          {{#Word Audio}}
            <div class="listening-view">
              <div class="audio-btn-wrapper">
                <button type="button" class="circular-audio-btn large-audio-btn" title="Play Word Audio" aria-label="Play word audio" onclick="playCircularAudio(this)">
                  <svg class="audio-progress-ring" viewBox="0 0 80 80">
                    <circle class="ring-bg" cx="40" cy="40" r="36" />
                    <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                  </svg>
                  <span class="audio-btn-content">
                    <span class="audio-btn-label">言葉</span>
                  </span>
                </button>
                <span class="raw-audio-source" aria-hidden="true">{{Word Audio}}</span>
              </div>
            </div>
          {{/Word Audio}}
        {{/Sentence Audio}}

        <!-- Bulletproof Fallback: Neither definition NOR audio exists -->
        {{^Sentence Audio}}
          {{^Word Audio}}
            <div class="sentence-display">
              {{#Sentence}}
                {{edit:Sentence}}
              {{/Sentence}}
              {{^Sentence}}
                {{edit:Expression}}
              {{/Sentence}}
            </div>
          {{/Word Audio}}
        {{/Sentence Audio}}

      {{/Extended definition}}
    {{/Definition}}

  </div>
</div>

<script>
  (async function() {
    /* --- 1. HOISTED UTILITIES & FUNCTIONS --- */
    
    /* Dynamic Font Scaling for Front Sentence / Expression */
    function autoScaleFrontText() {
      const displays = document.querySelectorAll('.sentence-display, .front-word-display');
      displays.forEach(el => {
        const text = el.innerText ? el.innerText.trim() : '';
        const len = text.length;
        if (len === 0) return;

        if (len <= 8) {
          el.dataset.len = 'short';
        } else if (len <= 18) {
          el.dataset.len = 'medium-short';
        } else if (len <= 35) {
          el.dataset.len = 'medium-long';
        } else {
          el.dataset.len = 'long';
        }
      });
    }

    /* --- CIRCULAR AUDIO CONTROLLER (native-only) ---
       Always delegates to Anki's own replay link (desktop `replay-button`,
       AnkiDroid `replaybutton`). Never constructs an HTML5 audio element:
       on AnkiDroid the rendered link carries no usable filename (old builds
       emit `playsound:q:0`, which would be loaded as a bogus file and fail).
       The ring is a decorative play-pulse, not true progress. */
    window.currentActiveBtn = window.currentActiveBtn || null;
    window.currentActiveTimer = window.currentActiveTimer || null;

    window.resetAudioState = function() {
        if (window.currentActiveTimer) {
            clearTimeout(window.currentActiveTimer);
            window.currentActiveTimer = null;
        }
        if (window.currentActiveBtn) {
            window.currentActiveBtn.classList.remove('is-playing');
            const ring = window.currentActiveBtn.querySelector('.ring-fill');
            if (ring) {
                const circ = parseFloat(ring.getAttribute('stroke-dasharray')) || 226.19;
                ring.style.transition = '';
                ring.style.strokeDashoffset = circ;
            }
            window.currentActiveBtn = null;
        }
    };

    window.playCircularAudio = function(btn) {
        /* Debounce: native playback can't be stopped programmatically, so
           ignore rapid re-taps on the already-playing button (prevents
           overlapping audio on AnkiDroid). */
        if (window.currentActiveBtn === btn) return;
        window.resetAudioState();
        const ringFill = btn.querySelector('.ring-fill');

        /* The replay link lives in the sibling .raw-audio-source (kept OUT
           of the <button>: <a> inside <button> is invalid HTML and Android
           WebView mishandles taps on it). */
        const scope = (btn.closest && btn.closest('.audio-btn-wrapper')) || document;
        const nativeReplay = scope.querySelector('.replaybutton, .replay-button, a.sound, .soundLink')
          || btn.querySelector('.replaybutton, .replay-button, a.sound, .soundLink');
        if (nativeReplay) {
            try { nativeReplay.click(); } catch (e) { return; }
            btn.classList.add('is-playing');
            if (ringFill) {
                ringFill.style.transition = 'stroke-dashoffset 0.8s ease-in-out';
                ringFill.style.strokeDashoffset = '0';
            }
            window.currentActiveBtn = btn;
            window.currentActiveTimer = setTimeout(() => {
                if (window.currentActiveBtn === btn) {
                    window.resetAudioState();
                }
            }, 800);
        }
    };

    /* --- 2. MAIN EXECUTION BLOCK --- */
    const container = document.querySelector('.card-container');
    const wrapper = document.querySelector('.card-wrapper');

    if (container && wrapper) {
      let wordMode = false;
      let interval = null;
      let source = 'unavailable';
      /* Latency probe: t0 at script start; elapsed retrieval time is
         logged with the decision, so AnkiConnect (desktop) vs bridge
         (mobile) costs can be compared per card. */
      const nowMs = () => (
        (typeof performance !== 'undefined' && performance.now)
          ? performance.now()
          : Date.now()
      );
      const t0 = nowMs();

      /* Safety Reveal: Ensure card shows even if async calls hang.
         The cap sits well above the slowest happy path (low hundreds
         of ms) and only binds failure paths. */
      const reveal = () => {
        container.style.visibility = 'visible';
        autoScaleFrontText();
      };
      const safetyTimeout = setTimeout(reveal, 1200);

      /* Anki-Connect helper with timeout. 500ms is ~15x the measured
         healthy localhost latency (~25ms/call), so it only ever binds
         a wedged/busy Anki — and the fallback is always the safe
         sentence front, never a hang. */
      const post = (action, params) => {
        const timeout = new Promise((_, rej) => 
          setTimeout(() => rej(new Error('AnkiConnect timeout')), 500)
        );
        const fetchPromise = fetch('http://127.0.0.1:8765', {
          method: 'POST',
          body: JSON.stringify({ action: action, version: 6, params: params })
        }).then(r => r.json()).then(data => {
          if (data.error) throw new Error(data.error);
          return data.result;
        });
        return Promise.race([fetchPromise, timeout]);
      };

      const escQuery = (s) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/([*_])/g, '\\$1');
      const normText = (s) => s
        .replace(/<br\s*\/?>/gi, ' ')
        .replace(/<[^>]+>/g, ' ')
        .replace(/&nbsp;/gi, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      try {
        /* Listening cards never use word mode — skip ALL retrieval up front
           (also avoids needless AnkiDroid JS-API calls, which can trigger
           AnkiDroid's known false-positive "Failed to load *.bin" toast). */
        const isListening = !!document.querySelector('.listening-view');
        /* Mobile WebViews (AnkiDroid / AnkiMobile) have no AnkiConnect: a
           fetch to 127.0.0.1 is refused and Android surfaces it natively as
           "Failed to load 'downloadfile.bin'". Never fetch from a phone. */
        const ua = (typeof navigator !== 'undefined' && navigator.userAgent) || '';
        const isMobile = /Android|iPhone|iPad|iPod/i.test(ua);
        /* AnkiDroid compatibility helpers */
        const bridgeAvailable = () =>
          typeof AnkiDroidJS !== 'undefined' &&
          AnkiDroidJS !== null;

        const withBridgeTimeout = (promise, ms) =>
          new Promise((resolve, reject) => {
            const timer = setTimeout(
              () => reject(new Error('AnkiDroid bridge timeout')),
              ms
            );

            Promise.resolve(promise).then(
              value => {
                clearTimeout(timer);
                resolve(value);
              },
              error => {
                clearTimeout(timer);
                reject(error);
              }
            );
          });

        /*
         * Accept:
         *   365
         *   "365"
         *   {success: true, value: 365}
         *   {success: true, value: "365"}
         *   JSON-encoded versions of these responses
         *
         * Never turn null, false, or an empty string into an interval.
         */
        const parseDroidInterval = raw => {
          let value = raw;

          for (let depth = 0; depth < 6; depth++) {
            if (typeof value === 'number') {
              if (!Number.isFinite(value) || value < 0) {
                throw new Error('No usable card interval');
              }
              return value;
            }

            if (typeof value === 'string') {
              const text = value.trim();

              if (!text) {
                throw new Error('Empty interval response');
              }

              // Ordinary numeric string.
              const number = Number(text);
              if (Number.isFinite(number)) {
                value = number;
                continue;
              }

              // JSON-encoded response.
              try {
                value = JSON.parse(text);
              } catch (_) {
                throw new Error(
                  'Unrecognized interval response: ' + text.slice(0, 120)
                );
              }
              continue;
            }

            if (value && typeof value === 'object') {
              if (
                value.success === false ||
                value.success === 'false'
              ) {
                throw new Error('AnkiDroid reported success=false');
              }

              if (
                Object.prototype.hasOwnProperty.call(value, 'value')
              ) {
                value = value.value;
                continue;
              }

              if (
                Object.prototype.hasOwnProperty.call(value, 'interval')
              ) {
                value = value.interval;
                continue;
              }
            }

            throw new Error('Unsupported interval response');
          }

          throw new Error('Unexpectedly nested interval response');
        };

        const getAnkiDroidInterval = async () => {
          try {
            const options = {
              developer: 'mansourvery-hub@users.noreply.github.com',
              version: '0.0.3'
            };

            let api;
            let apiKind;

            if (typeof AnkiDroidJS === 'function') {
              // Constructor-based API.
              api = new AnkiDroidJS(options);
              apiKind = 'constructor';
            } else {
              // Direct/native bridge API.
              api = AnkiDroidJS;
              apiKind = 'direct';

              if (typeof api.init === 'function') {
                const initialized = await withBridgeTimeout(
                  api.init(JSON.stringify(options)),
                  1000
                );

                if (
                  initialized === false ||
                  initialized === 'false'
                ) {
                  throw new Error('AnkiDroid API initialization failed');
                }
              }
            }

            if (
              !api ||
              typeof api.ankiGetCardInterval !== 'function'
            ) {
              throw new Error('ankiGetCardInterval is unavailable');
            }

            /* New-reviewer stub guard: AnkiDroid's fragment-based reviewer
               injects a placeholder AnkiDroidJS whose methods only navigate
               to 'signal:jsapi' (no data). Never invoke it — the navigation
               is unhandled and yields nothing. Detect by method source. */
            let methodSrc = '';
            try {
              methodSrc = Function.prototype.toString.call(api.ankiGetCardInterval);
            } catch (_) { /* fall through to the call */ }
            if (/signal\s*:\s*jsapi/.test(methodSrc)) {
              return {
                interval: null,
                source: 'ankiDroid-stub (reviewer without interval API)'
              };
            }

            const raw = await withBridgeTimeout(
              api.ankiGetCardInterval(),
              1000
            );

            return {
              interval: parseDroidInterval(raw),
              source: 'ankiDroid-' + apiKind
            };
          } catch (error) {
            return {
              interval: null,
              source: 'ankiDroid-error: ' +
                (error && error.message ? error.message : String(error))
            };
          }
        };
        /* Platform-exclusive retrieval. Phones use ONLY the AnkiDroid
           bridge (AnkiConnect is unreachable from a mobile WebView — the
           refused fetch surfaces natively as "Failed to load
           downloadfile.bin"). Desktops use ONLY AnkiConnect (no
           AnkiDroidJS global exists there). Neither platform ever
           attempts the other's method. */
        if (!isListening && isMobile) {
          if (bridgeAvailable()) {
            const r = await getAnkiDroidInterval();
            interval = r.interval;
            source = r.source;
          } else {
            /* Phone without an (already injected) bridge: AnkiDroid injects
               its API around card load, often AFTER card scripts run — so poll
               for it while the card is still hidden (no flash risk), then give
               up to the sentence front. 700ms cap: the legacy reviewer
               injects js-api.js synchronously in <head>, so a longer wait
               only delays preview screens, where the sentence fallback is
               correct anyway. */
            const waitForBridge = async (deadlineMs, stepMs) => {
              const start = Date.now();
              while (!bridgeAvailable()) {
                if (Date.now() - start >= deadlineMs) return false;
                await new Promise(r => setTimeout(r, stepMs));
              }
              return true;
            };
            if (await waitForBridge(700, 100)) {
              const r = await getAnkiDroidInterval();
              interval = r.interval;
              source = r.source;
            } else {
              /* No bridge script in the page: on AnkiDroid this means a
                 preview screen (card browser / template / editor preview),
                 never a real review — the legacy reviewer always injects
                 js-api.js synchronously via card_template.html <head>.
                 Sentence fallback is correct here; review the card for
                 real to exercise mature mode. */
              source = 'no-bridge-mobile (preview? bridge exists only in reviewer)';
            }
          }
        } else if (!isListening) {
          /* DESKTOP-ONLY: AnkiConnect guiCurrentCard -> cardsInfo. The
             bridge is never touched here. guiCurrentCard carries no
             interval field (per the AnkiConnect action docs), so the
             cardsInfo follow-up is mandatory, not redundant. */
          try {
            const current = await post('guiCurrentCard', {});
            if (current && current.cardId) {
              const infos = await post('cardsInfo', { cards: [current.cardId] });
              if (infos && infos[0]) {
                interval = infos[0].interval;
                source = 'guiCurrentCard';
              }
            }
          } catch (reviewErr) {
            console.log('[Mature Word Mode] no active review, trying content search');
            const wordEl = document.querySelector('.front-word-display');
            const sentEl = document.querySelector('.sentence-display');
            const listeningView = document.querySelector('.listening-view');
            const NOTE_TYPE = container.dataset.notetype || '';
            const exprDom = wordEl ? normText(wordEl.innerText || wordEl.textContent || '') : '';
            if (exprDom && !listeningView) {
              const query = '"Expression:' + escQuery(exprDom) + '" "note:' + escQuery(NOTE_TYPE) + '"';
              const ids = await post('findCards', { query: query });
              if (ids && ids.length) {
                const infos = await post('cardsInfo', { cards: ids });
                const fieldText = (info, name) =>
                  normText((info.fields && info.fields[name] && info.fields[name].value) || '');
                let matches = infos.filter(i => fieldText(i, 'Expression') === exprDom);
                if (matches.length > 1 && sentEl) {
                  const sentDom = normText(sentEl.innerText || sentEl.textContent || '');
                  const withSent = matches.filter(i => fieldText(i, 'Sentence') === sentDom);
                  if (withSent.length) matches = withSent;
                }
                if (matches.length) {
                  interval = matches[0].interval;
                  source = 'content-search';
                }
              }
            }
          }
        }
      } catch (e) {
        source = 'error: ' + (e && e.message ? e.message : String(e));
        console.warn('[Mature Word Mode]', e);
      } finally {
        clearTimeout(safetyTimeout);
        const elapsedMs = Math.round(nowMs() - t0);
        console.log('[Mature Word Mode] source=' + source +
          ' ivl=' + String(interval) + ' in ' + elapsedMs + 'ms');

        const LONG_INTERVAL_DAYS = 365;

        // Set to false after confirming that Android works.
        const DEBUG_MATURE_MODE = false;

        const listeningView = container.querySelector('.listening-view');
        const wordEl = container.querySelector('.front-word-display');
        const hasExpression = !!(
          wordEl && (wordEl.textContent || '').trim()
        );

        wordMode =
          typeof interval === 'number' &&
          Number.isFinite(interval) &&
          interval >= LONG_INTERVAL_DAYS &&
          !listeningView &&
          hasExpression;

        // Explicitly reset the class as well as enabling it.
        wrapper.classList.toggle('word-mode', wordMode);

        if (DEBUG_MATURE_MODE) {
          let diagnostic = wrapper.querySelector('.mwm-debug');

          if (!diagnostic) {
            diagnostic = document.createElement('div');
            diagnostic.className = 'mwm-debug';
            diagnostic.style.cssText =
              'padding:6px 10px;' +
              'font:12px/1.4 sans-serif;' +
              'color:var(--text-secondary,#888);' +
              'overflow-wrap:anywhere;' +
              'text-align:left;';
            wrapper.appendChild(diagnostic);
          }

          diagnostic.textContent =
            'Mature mode: ' + (wordMode ? 'ON' : 'OFF') +
            ' | interval=' + String(interval) +
            ' | threshold=' + LONG_INTERVAL_DAYS +
            ' | source=' + source +
            ' | ' + elapsedMs + 'ms';
        }

        reveal();
      }
    }
  })();
</script>
