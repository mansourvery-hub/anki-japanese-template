<!-- BACK CARD TEMPLATE
     Premium Ergonomic Dashboard (Tokyo Night / Aki Paper)
     Balanced 2-Column Layout for Desktop.
-->

<div class="card-wrapper">

  <!-- Sticky Status Bar (Tags) -->
  <div class="tags-container">
    <div id="tags-list" class="tags-list"></div>
    {{#Tags}}
      <div id="tags-raw" style="display: none;">{{Tags}}</div>
      <script>
        (function() {
          const raw = document.getElementById('tags-raw');
          const list = document.getElementById('tags-list');
          if (raw && list) {
            const tags = raw.innerText.trim().split(/\s+/);
            tags.forEach(tag => {
              if (tag) {
                const span = document.createElement('span');
                span.className = 'tag-pill';
                span.innerText = tag;
                list.appendChild(span);
              }
            });
          }
        })();
      </script>
    {{/Tags}}
  </div>

  <div class="card-container">
    <div class="back-grid">
      
      <!-- MAIN COLUMN: Critical Study Data -->
      <div class="main-content">
        
        <!-- Word Header Block -->
        <div class="card-block word-header">
          <div class="word-display">
            {{#furigana}}
              {{furigana:furigana}}
            {{/furigana}}
            {{^furigana}}
              {{Expression}}
            {{/furigana}}
          </div>

          <div class="word-meta-row">
            {{#Frequency}}
              <div class="frequency-badge">
                {{Frequency}}
              </div>
            {{/Frequency}}

            {{#Pitch Accent}}
              <div class="pitch-accent-badge">
                {{Pitch Accent}}
              </div>
            {{/Pitch Accent}}

            <div class="audio-row">
              {{#Word Audio}}
                <div class="audio-item">
                  <span>Word:</span> {{Word Audio}}
                </div>
              {{/Word Audio}}
              {{#Sentence Audio}}
                <div class="audio-item">
                  <span>Sentence:</span> {{Sentence Audio}}
                </div>
              {{/Sentence Audio}}
            </div>
          </div>

          {{#Definition}}
            <div class="definition-box">
              {{edit:Definition}}
            </div>
          {{/Definition}}
        </div>

        <!-- Sentence Block -->
        {{#Sentence}}
          <div class="card-block">
            <span class="field-label">Example Sentence</span>
            <div class="sentence-japanese">
              {{#Sentence (furigana)}}
                {{furigana:Sentence (furigana)}}
              {{/Sentence (furigana)}}
              {{^Sentence (furigana)}}
                {{Sentence}}
              {{/Sentence (furigana)}}
            </div>

            {{#Translation}}
              <div class="translation-box" onclick="this.classList.toggle('revealed')">
                <div class="translation-hint">👁️ View Translation</div>
                <div class="translation-text">{{edit:Translation}}</div>
              </div>
            {{/Translation}}

            {{#context}}
              <div style="margin-top: 24px;">
                <span class="field-label">Context</span>
                <div class="html-content">{{edit:context}}</div>
              </div>
            {{/context}}
          </div>
        {{/Sentence}}

      </div> <!-- End main-content -->

      <!-- SIDE COLUMN: Media & Supplementary -->
      <div class="side-content">
        
        <!-- Picture Block -->
        {{#Picture}}
          <div class="card-block" style="text-align: center; padding: 12px;">
            <div class="picture-container" id="pic-container">
              {{Picture}}
            </div>
          </div>
          
          <script>
            (function() {
              const container = document.getElementById('pic-container');
              if (container) {
                const img = container.querySelector('img');
                if (img) {
                  img.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const clone = this.cloneNode();
                    clone.className = 'expanded-img';
                    const overlay = document.createElement('div');
                    overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:1999;backdrop-filter:blur(8px);';
                    document.body.appendChild(overlay);
                    document.body.appendChild(clone);
                    
                    const close = () => {
                      document.body.removeChild(overlay);
                      document.body.removeChild(clone);
                    };
                    overlay.onclick = close;
                    clone.onclick = close;
                  });
                }
              }
            })();
          </script>
        {{/Picture}}

        <!-- Kanji Notes -->
        {{#Kanji Notes}}
          <div class="card-block">
            <span class="field-label">Kanji Notes</span>
            <div class="html-content">{{edit:Kanji Notes}}</div>
          </div>
        {{/Kanji Notes}}

        <!-- General Notes -->
        {{#Notes}}
          <div class="card-block">
            <span class="field-label">General Notes</span>
            <div class="html-content">{{edit:Notes}}</div>
          </div>
        {{/Notes}}

        <!-- Moved: Extended Definitions -->
        {{#Extended definition}}
          <div class="details-wrapper">
            <details class="modern-details">
              <summary class="modern-summary">
                <span>Extended Japanese Definition</span>
                <span>▼</span>
              </summary>
              <div class="extended-def-content">
                {{Extended definition}}
              </div>
            </details>
          </div>
        {{/Extended definition}}

      </div> <!-- End side-content -->

    </div> <!-- End back-grid -->

    <!-- Footer -->
    {{#Source}}
      <div class="source-footer">
        Source: {{Source}}
      </div>
    {{/Source}}

  </div> <!-- End card-container -->
</div>
