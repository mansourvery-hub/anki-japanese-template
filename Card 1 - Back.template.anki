<!-- BACK CARD TEMPLATE
     Displays vocabulary details, audio players, definitions, and usage examples.
     Features include hover furigana, interactive image lightbox, and collapsible sections.
-->

<div class="card-wrapper">

  <!-- Floating Header Information -->
  <div class="tags-container" id="tags-container">
    {{#Tags}}
      <div id="tags-raw" style="display: none;">{{Tags}}</div>
      <div id="tags-list" style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;"></div>
      <script>
        (function() {
          var raw = document.getElementById('tags-raw');
          var list = document.getElementById('tags-list');
          if (raw && list) {
            var tags = raw.innerText.trim().split(/\s+/);
            tags.forEach(function(tag) {
              if (tag) {
                var span = document.createElement('span');
                span.className = 'tag-pill';
                span.innerText = tag;
                list.appendChild(span);
              }
            });
          }
        })();
      </script>
    {{/Tags}}
  </div>

  <div class="card-container">

    <!-- Primary Term & Definition -->
    <div class="card-block word-header-block">
      
      <div class="word-row">
        <div class="word-display hover-furigana">
          {{#furigana}}
            {{furigana:furigana}}
          {{/furigana}}
          {{^furigana}}
            {{Expression}}
          {{/furigana}}
        </div>
        
        {{#Frequency}}
          <span class="frequency-badge">{{Frequency}}</span>
        {{/Frequency}}
      </div>

      {{#Pitch Accent}}
        <div class="pitch-accent-container">
          {{Pitch Accent}}
        </div>
      {{/Pitch Accent}}

      <div class="audio-group">
        {{#Word Audio}}
          <span class="audio-item">
            <span class="audio-label">Word</span> {{Word Audio}}
          </span>
        {{/Word Audio}}
        {{#Sentence Audio}}
          <span class="audio-item">
            <span class="audio-label">Sentence</span> {{Sentence Audio}}
          </span>
        {{/Sentence Audio}}
      </div>

      {{#Definition}}
        <hr class="definition-divider">
        <div class="word-definition-container">
          {{Definition}}
        </div>
      {{/Definition}}

    </div>

    <!-- Usage Sentence & Translation -->
    {{#Sentence}}
      <div class="card-block sentence-block">
        <span class="sentence-title">Sentence</span>
        
        <div class="sentence-japanese hover-furigana">
          {{#Sentence (furigana)}}
            {{furigana:Sentence (furigana)}}
          {{/Sentence (furigana)}}
          {{^Sentence (furigana)}}
            {{Sentence}}
          {{/Sentence (furigana)}}
        </div>

        {{#Translation}}
          <div class="translation-wrapper" onclick="this.classList.toggle('revealed')">
            <div class="translation-hint">👁️ Show Translation</div>
            <div class="translation-text">{{Translation}}</div>
          </div>
        {{/Translation}}

        {{#context}}
          <div class="context-container">
            <span class="context-title">Context</span>
            <div class="context-body">{{context}}</div>
          </div>
        {{/context}}
      </div>
    {{/Sentence}}

    <!-- Visual Media Content -->
    {{#Picture}}
      <div class="picture-wrapper">
        <div class="picture-container" id="pic-container">
          {{Picture}}
        </div>
        <div class="picture-overlay" id="pic-overlay"></div>
      </div>

      <script>
        (function() {
          var container = document.getElementById('pic-container');
          var overlay = document.getElementById('pic-overlay');
          if (container && overlay) {
            var img = container.querySelector('img');
            if (img) {
              img.addEventListener('click', function(e) {
                e.stopPropagation();
                container.classList.toggle('expanded');
              });
              overlay.addEventListener('click', function() {
                container.classList.remove('expanded');
              });
              document.addEventListener('click', function(e) {
                if (e.target !== img) {
                  container.classList.remove('expanded');
                }
              });
            }
          }
        })();
      </script>
    {{/Picture}}

    <!-- Supplementary Notes -->
    {{#Kanji Notes}}
      <div class="card-block">
        <span class="field-label">Kanji Notes</span>
        <div class="field-value html-content">{{Kanji Notes}}</div>
      </div>
    {{/Kanji Notes}}

    {{#Notes}}
      <div class="card-block">
        <span class="field-label">Notes</span>
        <div class="field-value html-content">{{Notes}}</div>
      </div>
    {{/Notes}}

    <!-- Lexical Reference -->
    {{#Extended definition}}
      <div class="extended-def-container">
        <details class="modern-details">
          <summary class="modern-summary">
            <span class="summary-title">Extended Definition</span>
            <span class="summary-icon">▼</span>
          </summary>
          <div class="extended-def-content html-content">
            {{Extended definition}}
          </div>
        </details>
      </div>
    {{/Extended definition}}

    <!-- Source Information -->
    {{#Source}}
      <div class="source-container">
        <span class="source-label">Source:</span> <span class="source-value">{{Source}}</span>
      </div>
    {{/Source}}

  </div>
</div>
