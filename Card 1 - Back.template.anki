<!-- BACK CARD TEMPLATE
     Premium Ergonomic Japanese Back Card
     
     Structure:
     - Sticky Tags Bar
     - 2-Column Desktop Grid / 1-Column Mobile Layout
     - Main: Word/Furigana, Frequency/Pitch, Circular Audio Buttons, Definition, Sentence & Translation
     - Side: Lightbox Picture, Kanji Notes, General Notes, Extended Definition
-->

<div class="card-wrapper back-card">

  <!-- Sticky Tags Bar -->
  {{#Tags}}
    <div class="tags-container">
      <div class="tags-list"></div>
      <div class="tags-raw" style="display: none;">{{Tags}}</div>
      <script>
        (function() {
          const raw = document.querySelector('.tags-raw');
          const list = document.querySelector('.tags-list');
          if (raw && list && !list.hasChildNodes()) {
            const tags = raw.innerText.trim().split(/\s+/);
            tags.forEach(tag => {
              if (tag) {
                const span = document.createElement('span');
                span.className = 'tag-pill';
                span.innerText = tag;
                list.appendChild(span);
              }
            });
          }
        })();
      </script>
    </div>
  {{/Tags}}

  <div class="card-container">
    <div class="back-grid">
      
      <!-- MAIN COLUMN -->
      <div class="main-content">
        
        <!-- Word Header -->
        <div class="card-block word-header">
          
          <!-- Word Header (hidden entirely when the word fields are empty:
               audio-only / picture-only cards no longer show a padded void) -->
          {{#furigana}}
            <div class="word-display">
              {{edit:furigana:furigana}}
            </div>
          {{/furigana}}
          {{^furigana}}
            {{#Expression}}
              <div class="word-display">
                {{edit:furigana:Expression}}
              </div>
            {{/Expression}}
          {{/furigana}}

          <!-- Metadata & Circular Audio Controllers -->
          <div class="word-meta-row">
            {{#Frequency}}
              <div class="frequency-badge" data-freq="{{Frequency}}">
                <div class="frequency-bar-track">
                  <div class="frequency-bar-fill"></div>
                </div>
                <span class="frequency-stars"></span>
              </div>
            {{/Frequency}}

            {{#Pitch Accent}}
              <div class="pitch-accent-badge">
                {{edit:Pitch Accent}}
              </div>
            {{/Pitch Accent}}

            <!-- Circular Audio Buttons with SVG Progress Ring -->
            <div class="audio-row">
              {{#Word Audio}}
                <button type="button" class="circular-audio-btn small-audio-btn" title="Play Word Audio" aria-label="Play word audio" onclick="playCircularAudio(this)">
                  <svg class="audio-progress-ring" viewBox="0 0 44 44">
                    <circle class="ring-bg" cx="22" cy="22" r="19" />
                    <circle class="ring-fill" cx="22" cy="22" r="19" stroke-dasharray="119.38" stroke-dashoffset="119.38" />
                  </svg>
                  <div class="audio-btn-content">
                    <span class="audio-btn-label">言葉</span>
                  </div>
                  <div class="raw-audio-source" style="display:none;">{{Word Audio}}</div>
                </button>
              {{/Word Audio}}
              
              {{#Sentence Audio}}
                <button type="button" class="circular-audio-btn small-audio-btn" title="Play Sentence Audio" aria-label="Play sentence audio" onclick="playCircularAudio(this)">
                  <svg class="audio-progress-ring" viewBox="0 0 44 44">
                    <circle class="ring-bg" cx="22" cy="22" r="19" />
                    <circle class="ring-fill" cx="22" cy="22" r="19" stroke-dasharray="119.38" stroke-dashoffset="119.38" />
                  </svg>
                  <div class="audio-btn-content">
                    <span class="audio-btn-label">文</span>
                  </div>
                  <div class="raw-audio-source" style="display:none;">{{Sentence Audio}}</div>
                </button>
              {{/Sentence Audio}}
            </div>
          </div>

          <!-- Main Definition (compact: see "Definition Compactor" CSS section) -->
          {{#Definition}}
            <div class="definition-box primary-definition">
              {{edit:furigana:Definition}}
            </div>
          {{/Definition}}

          <!-- Fallback: Show Extended definition if Definition is absent
               (compacted identically — see 6b DEFINITION COMPACTOR in CSS) -->
          {{^Definition}}
            {{#Extended definition}}
              <div class="definition-box primary-definition">
                {{Extended definition}}
              </div>
            {{/Extended definition}}
          {{/Definition}}
        </div>

        <!-- Sentence Block -->
        {{#Sentence}}
          <div class="card-block sentence-block">
            <div class="sentence-japanese">
              {{#Sentence (furigana)}}
                {{edit:furigana:Sentence (furigana)}}
              {{/Sentence (furigana)}}
              {{^Sentence (furigana)}}
                {{edit:Sentence}}
              {{/Sentence (furigana)}}
            </div>

            {{#Translation}}
              <div class="translation-box"
                   role="button"
                   tabindex="0"
                   aria-expanded="false"
                   onclick="this.classList.toggle('revealed'); this.setAttribute('aria-expanded', this.classList.contains('revealed'))"
                   onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}">
                <div class="translation-hint">👁️ Translation</div>
                <div class="translation-text">{{edit:Translation}}</div>
              </div>
            {{/Translation}}

            {{#context}}
              <div class="context-block">
                <div class="html-content">{{edit:context}}</div>
              </div>
            {{/context}}
          </div>
        {{/Sentence}}

        <!-- Orphan Translation / Context (When Sentence is empty) -->
        {{^Sentence}}
          {{#Translation}}
            <div class="card-block">
              <div class="translation-text" style="display: block;">{{edit:Translation}}</div>
            </div>
          {{/Translation}}

          {{#context}}
            <div class="card-block">
              <div class="html-content">{{edit:context}}</div>
            </div>
          {{/context}}
        {{/Sentence}}

      </div> <!-- End main-content -->

      <!-- SIDE COLUMN -->
      <div class="side-content">
         
        <!-- Picture Block (Click to Expand Lightbox) -->
        {{#Picture}}
          <div class="card-block picture-block">
            <div class="picture-container" onclick="openLightbox(this)">
              {{Picture}}
            </div>
          </div>
        {{/Picture}}

        <!-- Kanji Notes -->
        {{#Kanji Notes}}
          <div class="card-block">
            <div class="html-content">{{edit:Kanji Notes}}</div>
          </div>
        {{/Kanji Notes}}

        <!-- General Notes -->
        {{#Notes}}
          <div class="card-block">
            <div class="html-content">{{edit:furigana:Notes}}</div>
          </div>
        {{/Notes}}

        <!-- Extended Definition Accordion (Only when standard Definition also exists) -->
        {{#Definition}}
          {{#Extended definition}}
            <div class="details-wrapper">
              <details class="modern-details">
                <summary class="modern-summary" tabindex="0">
                  <span>Extended Definition</span>
                  <span>▼</span>
                </summary>
                <div class="extended-def-content">
                  {{Extended definition}}
                </div>
              </details>
            </div>
          {{/Extended definition}}
        {{/Definition}}

      </div> <!-- End side-content -->

    </div> <!-- End back-grid -->

    <!-- Footer -->
    {{#Source}}
      <div class="source-footer">
        {{edit:Source}}
      </div>
    {{/Source}}

  </div> <!-- End card-container -->
</div>

<!-- Lightbox & Audio Scripts -->
<script>
  (function() {
    /* NOTE: sentence font sizing is pure CSS now.
       The stylesheet's .sentence-japanese clamp() is the single source of
       truth. A previous JS length-tier scaler overrode it with an inline
       font-size, which silently defeated any manual CSS edits. */

    /* --- LIGHTBOX CONTROLLER (click to expand / click outside to close) --- */
    window.openLightbox = function(target) {
      const img = target.querySelector('img') || (target.tagName === 'IMG' ? target : null);
      if (!img) return;
      if (document.querySelector('.lightbox-overlay')) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');

      const clone = document.createElement('img');
      clone.src = img.src;
      clone.className = 'expanded-img';
      if (img.alt) clone.alt = img.alt;

      overlay.appendChild(clone);
      document.body.appendChild(overlay);

      const closeOverlay = () => {
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        document.removeEventListener('keydown', handleKey);
        if (img.focus) img.focus();
      };

      const handleKey = (e) => {
        if (e.key === 'Escape') closeOverlay();
      };

      /* Only a click on the backdrop itself (outside the image) closes —
         clicks on the enlarged image stop here and never bubble up. */
      overlay.onclick = (e) => {
        if (e.target === overlay) closeOverlay();
      };
      document.addEventListener('keydown', handleKey);
    };

    /* --- CIRCULAR AUDIO CONTROLLER --- */
    window.currentActiveAudio = window.currentActiveAudio || null;
    window.currentActiveBtn = window.currentActiveBtn || null;

    window.resetAudioState = function() {
        if (window.currentActiveAudio) {
            window.currentActiveAudio.pause();
            window.currentActiveAudio = null;
        }
        if (window.currentActiveBtn) {
            window.currentActiveBtn.classList.remove('is-playing');
            const ring = window.currentActiveBtn.querySelector('.ring-fill');
            if (ring) {
                const circ = parseFloat(ring.getAttribute('stroke-dasharray')) || 119.38;
                ring.style.strokeDashoffset = circ;
            }
            window.currentActiveBtn = null;
        }
    };

    window.playCircularAudio = function(btn) {
        window.resetAudioState();
        const ringFill = btn.querySelector('.ring-fill');
        const circumference = ringFill ? parseFloat(ringFill.getAttribute('stroke-dasharray')) : 119.38;

        const rawDiv = btn.querySelector('.raw-audio-source');
        let audioSrc = '';
        if (rawDiv) {
            /* Robust regex: [^"'>\]]+ allows spaces, ] terminates sound: */
            const match = rawDiv.innerHTML.match(/(?:src=["']|sound:)([^"'>\]]+)/i);
            if (match) audioSrc = match[1];
        }

        const nativeReplay = btn.querySelector('.replaybutton, .replay-button, a.sound, .soundLink');
        if (!audioSrc) {
            if (nativeReplay) nativeReplay.click();
            return;
        }

        const audio = new Audio(audioSrc);
        window.currentActiveAudio = audio;
        window.currentActiveBtn = btn;
        btn.classList.add('is-playing');

        audio.play().catch(() => {
            window.resetAudioState();
            if (nativeReplay) nativeReplay.click();
        });

        audio.onended = audio.onabort = audio.onerror = () => {
            if (window.currentActiveAudio === audio) {
                window.resetAudioState();
            }
        };

         const updateProgress = () => {
             if (window.currentActiveAudio === audio && !audio.paused && audio.duration) {
                 const progress = audio.currentTime / audio.duration;
                 ringFill.style.strokeDashoffset = circumference * (1 - Math.min(Math.max(progress, 0), 1));
                 requestAnimationFrame(updateProgress);
             }
         };
         requestAnimationFrame(updateProgress);
     };

    /* --- FREQUENCY VISUALIZER (Progress Bar + 5-Star Scale + Tier Colors) --- */
    window.renderFrequencyIndicator = function() {
      const badges = document.querySelectorAll('.frequency-badge[data-freq]');
      badges.forEach(badge => {
        const raw = badge.getAttribute('data-freq') || '';
        const match = raw.replace(/,/g, '').match(/\d+(?:\.\d+)?/);
        if (!match) return;

        const val = parseFloat(match[0]);
        if (isNaN(val) || val <= 0) return;

        // Japanese Frequency Tiers (Top 500 / 2.5k / 7k / 18k / Rare)
        let stars = 1;
        let tierClass = 'freq-rare';
        let tierLabel = 'Rare';
        let fillPercent = 15;

        if (val <= 500) {
          stars = 5;
          tierClass = 'freq-very-common';
          tierLabel = 'Very Common (Top 500)';
          fillPercent = 95;
        } else if (val <= 2500) {
          stars = 4;
          tierClass = 'freq-common';
          tierLabel = 'Common (Top 2.5k)';
          fillPercent = 75;
        } else if (val <= 7000) {
          stars = 3;
          tierClass = 'freq-medium';
          tierLabel = 'Intermediate (Top 7k)';
          fillPercent = 55;
        } else if (val <= 18000) {
          stars = 2;
          tierClass = 'freq-uncommon';
          tierLabel = 'Advanced (Top 18k)';
          fillPercent = 35;
        } else {
          stars = 1;
          tierClass = 'freq-rare';
          tierLabel = 'Rare (18k+)';
          fillPercent = 15;
        }

        badge.classList.add(tierClass);
        /* (per M) in hover/tooltip per instructions; no percentages typed out */
        badge.setAttribute('title', `Frequency: ${raw.trim()} (per M) • ${tierLabel}`);
        badge.setAttribute('aria-label', `Frequency: ${tierLabel}`);

        const fill = badge.querySelector('.frequency-bar-fill');
        if (fill) fill.style.width = fillPercent + '%';

        const starContainer = badge.querySelector('.frequency-stars');
        if (starContainer) {
          starContainer.textContent = '★'.repeat(stars) + '☆'.repeat(5 - stars);
        }
      });
    };

    window.renderFrequencyIndicator();
  })();
</script>
