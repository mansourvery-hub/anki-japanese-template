<!-- BACK CARD TEMPLATE
     - Optimized for space efficiency: merges word header and main definition into a single block.
     - Displays the Frequency badge at the very top immediately next to the word.
     - Sentence translation is hidden by default and reveals itself smoothly when clicked.
     - Completely hides 'Reading' and 'Original Inflected Term' blocks.
     - Implements fixed floating tag pills at the top, hover furigana, interactive lightbox picture,
       and native pure HTML/CSS collapsible extended definitions.
-->

<div class="card-wrapper">

  <!-- Floating Sticky Tag Bar -->
  <div class="tags-container" id="tags-container">
    {{#Tags}}
      <!-- Raw Anki tags (hidden, parsed into beautiful pills by the script below) -->
      <div id="tags-raw" style="display: none;">{{Tags}}</div>
      <div id="tags-list" style="display: flex; gap: 4px; flex-wrap: wrap; justify-content: center;"></div>
      
      <script>
        (function() {
          var raw = document.getElementById('tags-raw');
          var list = document.getElementById('tags-list');
          if (raw && list) {
            // Split Anki space-separated tags and create pill components
            var tags = raw.innerText.trim().split(/\s+/);
            tags.forEach(function(tag) {
              if (tag) {
                var span = document.createElement('span');
                span.className = 'tag-pill';
                span.innerText = tag;
                list.appendChild(span);
              }
            });
          }
        })();
      </script>
    {{/Tags}}
  </div>

  <!-- Main Card Body -->
  <div class="card-container">

    <!-- 1. UNIFIED WORD & DEFINITION CARD BLOCK (Combines elements to fully eliminate empty space)
         Contains: Word (with hover furigana), Frequency (next to word), Pitch Accent, Audio players, and Main Definition.
    -->
    <div class="card-block word-header-block">
      
      <!-- Word display and Frequency tag inline -->
      <div class="word-row">
        <div class="word-display hover-furigana">
          {{#furigana}}
            {{furigana:furigana}}
          {{/furigana}}
          {{^furigana}}
            {{Expression}}
          {{/furigana}}
        </div>
        
        <!-- Frequency rating displayed at the top, next to the word, easy to spot -->
        {{#Frequency}}
          <span class="frequency-badge" title="Frequency Rating">{{Frequency}}</span>
        {{/Frequency}}
      </div>

      <!-- Pitch Accent rating -->
      {{#Pitch Accent}}
        <div class="pitch-accent-container">
          {{Pitch Accent}}
        </div>
      {{/Pitch Accent}}

      <!-- Styled side-by-side audio players -->
      <div class="audio-group">
        {{#Word Audio}}
          <span class="audio-item">
            <span class="audio-label">Word</span> {{Word Audio}}
          </span>
        {{/Word Audio}}
        {{#Sentence Audio}}
          <span class="audio-item">
            <span class="audio-label">Sentence</span> {{Sentence Audio}}
          </span>
        {{/Sentence Audio}}
      </div>

      <!-- Main Word Definition (Sits within the top card divided by a clean line) -->
      {{#Definition}}
        <hr class="definition-divider">
        <div class="word-definition-container">
          {{Definition}}
        </div>
      {{/Definition}}

    </div>


    <!-- 2. SENTENCE BLOCK (Shows only if sentence has content)
         Displays sentence with hover furigana, interactive translation reveal, and context.
    -->
    {{#Sentence}}
      <div class="card-block sentence-block">
        <span class="sentence-title">Sentence</span>
        
        <!-- Japanese sentence with hover furigana -->
        <div class="sentence-japanese hover-furigana">
          {{#Sentence (furigana)}}
            {{furigana:Sentence (furigana)}}
          {{/Sentence (furigana)}}
          {{^Sentence (furigana)}}
            {{Sentence}}
          {{/Sentence (furigana)}}
        </div>

        <!-- Interactive Click-to-Reveal Sentence translation -->
        {{#Translation}}
          <div class="translation-wrapper" onclick="this.classList.toggle('revealed')">
            <div class="translation-hint">👁️ Click to show translation</div>
            <div class="translation-text">{{Translation}}</div>
          </div>
        {{/Translation}}

        <!-- Paragraph/dialogue context if available -->
        {{#context}}
          <div class="context-container">
            <span class="context-title">Context</span>
            <div class="context-body">{{context}}</div>
          </div>
        {{/context}}
      </div>
    {{/Sentence}}


    <!-- 3. PICTURE BLOCK (Shows only if present, with click-to-expand lightbox) -->
    {{#Picture}}
      <div class="picture-wrapper">
        <div class="picture-container" id="pic-container">
          {{Picture}}
        </div>
        <div class="picture-overlay" id="pic-overlay"></div>
      </div>

      <!-- Lightweight interaction script for lightbox zoom -->
      <script>
        (function() {
          var container = document.getElementById('pic-container');
          var overlay = document.getElementById('pic-overlay');
          if (container && overlay) {
            var img = container.querySelector('img');
            if (img) {
              img.addEventListener('click', function(e) {
                e.stopPropagation();
                container.classList.toggle('expanded');
              });
              overlay.addEventListener('click', function() {
                container.classList.remove('expanded');
              });
              document.addEventListener('click', function(e) {
                if (e.target !== img) {
                  container.classList.remove('expanded');
                }
              });
            }
          }
        })();
      </script>
    {{/Picture}}


    <!-- 4. CONDITIONAL KANJI AND NOTES BLOCKS
         (Reading and Original Inflected Term are completely removed)
    -->
    
    <!-- Kanji Notes Block -->
    {{#Kanji Notes}}
      <div class="card-block">
        <span class="field-label">Kanji Notes</span>
        <div class="field-value html-content">{{Kanji Notes}}</div>
      </div>
    {{/Kanji Notes}}

    <!-- Miscellaneous General Notes Block -->
    {{#Notes}}
      <div class="card-block">
        <span class="field-label">Notes</span>
        <div class="field-value html-content">{{Notes}}</div>
      </div>
    {{/Notes}}


    <!-- 5. COLLAPSIBLE EXTENDED DEFINITION ACCORDION (Native HTMLdetails/summary) -->
    {{#Extended definition}}
      <div class="extended-def-container">
        <details class="modern-details">
          <summary class="modern-summary">
            <span class="summary-title">Extended Definition (Yomitan)</span>
            <span class="summary-icon">▼</span>
          </summary>
          <div class="extended-def-content html-content">
            {{Extended definition}}
          </div>
        </details>
      </div>
    {{/Extended definition}}


    <!-- 6. SOURCE FOOTER (At the very bottom) -->
    {{#Source}}
      <div class="source-container">
        <span class="source-label">Source:</span> <span class="source-value">{{Source}}</span>
      </div>
    {{/Source}}

  </div>

</div>
