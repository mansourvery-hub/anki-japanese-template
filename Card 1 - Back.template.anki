<!-- BACK CARD TEMPLATE
     Premium Ergonomic Japanese Card Back
     
     Layout: Tokyo Night Dark Theme / Aki Paper Light Theme
     - Features a balanced 2-column dashboard design for desktop.
     - Scoped, non-colliding inline scripts optimized for Anki's WebView reuse.
     
     Structure:
     1. Sticky Status Bar: Dynamically populated tags with local scoping.
     2. Main Column: Core lexical information (Word, Pitch Accent, Definition, and Sentence block with interactive Translation).
     3. Side Column: Sourced media (Lightbox-ready images) and supplementary notes (Kanji, general notes, and extended definition accordion).
-->

<div class="card-wrapper">

  <!-- ==========================================
       STICKY STATUS BAR (Tags)
       Only renders if the card has tags. Fully scoped to prevent ID collisions.
       ========================================== -->
  {{#Tags}}
    <div class="tags-container">
      <div class="tags-list"></div>
      <div class="tags-raw" style="display: none;">{{Tags}}</div>
      <script>
        (function() {
          // Robust self-location to prevent global DOM ID lookup conflicts
          const currentScript = document.currentScript || (function() {
            const scripts = document.getElementsByTagName('script');
            return scripts[scripts.length - 1];
          })();
          const container = currentScript.closest('.tags-container');
          if (container) {
            const raw = container.querySelector('.tags-raw');
            const list = container.querySelector('.tags-list');
            if (raw && list) {
              // Parse space-separated tags and generate clean, stylized pill elements
              const tags = raw.innerText.trim().split(/\s+/);
              tags.forEach(tag => {
                if (tag) {
                  const span = document.createElement('span');
                  span.className = 'tag-pill';
                  span.innerText = tag;
                  list.appendChild(span);
                }
              });
            }
          }
        })();
      </script>
    </div>
  {{/Tags}}

  <div class="card-container">
    <div class="back-grid">
      
      <!-- ==========================================
           MAIN COLUMN: Critical Study Data
           ========================================== -->
      <div class="main-content">
        
        <!-- Word Header Block (Word Display, Frequency, Pitch, Audios, Definition) -->
        <div class="card-block word-header">
          
          <!-- Word/Furigana Display with Hover Fallbacks -->
          <div class="word-display">
            {{#furigana}}
              {{furigana:furigana}}
            {{/furigana}}
            {{^furigana}}
              {{#Expression}}
                {{Expression}}
              {{/Expression}}
              {{^Expression}}
                <span style="opacity: 0.3;">(No Expression)</span>
              {{/Expression}}
            {{/furigana}}
          </div>

          <!-- Meta badges & Audio Trigger Row -->
          <div class="word-meta-row">
            {{#Frequency}}
              <div class="frequency-badge">
                {{edit:Frequency}}
              </div>
            {{/Frequency}}

            {{#Pitch Accent}}
              <div class="pitch-accent-badge">
                {{edit:Pitch Accent}}
              </div>
            {{/Pitch Accent}}

            <!-- Universal cross-platform audio controllers -->
            <div class="audio-row">
              {{#Word Audio}}
                <div class="audio-item word-audio" 
                     title="Play Word Audio" 
                     onclick="(this.querySelector('.replaybutton') || this.querySelector('.replay-button') || this.querySelector('a.sound') || this.querySelector('.soundLink'))?.click()">
                  <span class="audio-badge">言葉</span>
                  <div class="audio-btn-circle">{{Word Audio}}</div>
                </div>
              {{/Word Audio}}
              
              {{#Sentence Audio}}
                <div class="audio-item sentence-audio" 
                     title="Play Sentence Audio" 
                     onclick="(this.querySelector('.replaybutton') || this.querySelector('.replay-button') || this.querySelector('a.sound') || this.querySelector('.soundLink'))?.click()">
                  <span class="audio-badge">文</span>
                  <div class="audio-btn-circle">{{Sentence Audio}}</div>
                </div>
              {{/Sentence Audio}}
            </div>
          </div>

          <!-- Primary definition block -->
          {{#Definition}}
            <div class="definition-box">
              {{edit:Definition}}
            </div>
          {{/Definition}}

          <!-- Intelligent fallback definition: If primary definition is empty,
               automatically render the Extended Japanese Definition in the main box
               to save screen real estate and reduce required clicks. -->
          {{^Definition}}
            {{#Extended definition}}
              <div class="definition-box extended-definition-fallback">
                <span class="field-label" style="margin-bottom: 4px;">Extended Definition</span>
                {{edit:Extended definition}}
              </div>
            {{/Extended definition}}
          {{/Definition}}
        </div>

        <!-- Sentence Block: Rendered if 'Sentence' is populated -->
        {{#Sentence}}
          <div class="card-block sentence-block">
            <span class="field-label">Sentence</span>
            <div class="sentence-japanese">
              {{#Sentence (furigana)}}
                {{furigana:Sentence (furigana)}}
              {{/Sentence (furigana)}}
              {{^Sentence (furigana)}}
                {{edit:Sentence}}
              {{/Sentence (furigana)}}
            </div>

            {{#Translation}}
              <div class="translation-box"
                   role="button"
                   tabindex="0"
                   aria-expanded="false"
                   aria-label="View Translation"
                   onclick="this.classList.toggle('revealed'); this.setAttribute('aria-expanded', this.classList.contains('revealed'))"
                   onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}">
                <div class="translation-hint">👁️ View Translation</div>
                <div class="translation-text">{{edit:Translation}}</div>
              </div>
            {{/Translation}}

            {{#context}}
              <div class="context-block">
                <span class="field-label-sub" style="font-size: 0.65rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase;">Context</span>
                <div class="html-content">{{edit:context}}</div>
              </div>
            {{/context}}
          </div>
        {{/Sentence}}

        <!-- Pathological Fix: Decoupled translation & context blocks
             Renders Translation and Context if Sentence is empty, so they aren't hidden. -->
        {{^Sentence}}
          {{#Translation}}
            <div class="card-block translation-orphan-block">
              <span class="field-label">Translation</span>
              <div class="translation-box revealed" style="cursor: default; pointer-events: none;">
                <div class="translation-text" style="display: block;">{{edit:Translation}}</div>
              </div>
            </div>
          {{/Translation}}

          {{#context}}
            <div class="card-block context-orphan-block">
              <span class="field-label">Context</span>
              <div class="html-content">{{edit:context}}</div>
            </div>
          {{/context}}
        {{/Sentence}}

      </div> <!-- End main-content -->

      <!-- ==========================================
           SIDE COLUMN: Media & Supplementary
           ========================================== -->
      <div class="side-content">
         
        <!-- Picture Block: Lightbox capable image display -->
        {{#Picture}}
          <div class="card-block picture-block">
            <div class="picture-container">
              {{Picture}}
            </div>
          </div>
          
          <script>
            (function() {
              // Local containment selection to avoid ID clashes or stale web view references
              const currentScript = document.currentScript || (function() {
                const scripts = document.getElementsByTagName('script');
                return scripts[scripts.length - 1];
              })();
              const block = currentScript.closest('.picture-block');
              if (block) {
                // Select all images inside the block to support multi-image setups
                const images = block.querySelectorAll('.picture-container img');
                images.forEach(img => {
                  img.addEventListener('click', function(e) {
                    e.stopPropagation();
                    
                    // Prevent piling up multiple overlays
                    if (document.querySelector('.lightbox-overlay')) return;

                    const clone = this.cloneNode();
                    clone.className = 'expanded-img';
                    
                    const overlay = document.createElement('div');
                    overlay.className = 'lightbox-overlay';
                    overlay.appendChild(clone);
                    document.body.appendChild(overlay);

                    // Reusable close routine to detach event listeners properly
                    const closeOverlay = () => {
                      if (overlay.parentNode) {
                        document.body.removeChild(overlay);
                      }
                      document.removeEventListener('keydown', handleKeyDown);
                    };

                    // Close lightbox on Escape key
                    const handleKeyDown = (event) => {
                      if (event.key === 'Escape') {
                        closeOverlay();
                      }
                    };

                    overlay.onclick = closeOverlay;
                    clone.onclick = closeOverlay;
                    document.addEventListener('keydown', handleKeyDown);
                  });
                });
              }
            })();
          </script>
        {{/Picture}}

        <!-- Kanji Notes Section -->
        {{#Kanji Notes}}
          <div class="card-block">
            <span class="field-label">Kanji Notes</span>
            <div class="html-content">{{edit:Kanji Notes}}</div>
          </div>
        {{/Kanji Notes}}

        <!-- General Notes Section -->
        {{#Notes}}
          <div class="card-block">
            <span class="field-label">General Notes</span>
            <div class="html-content">{{edit:Notes}}</div>
          </div>
        {{/Notes}}

        <!-- Extended Definitions Accordion:
             Only displayed if standard Definition exists.
             (If Definition is missing, Extended definition renders directly in the main Word Header). -->
        {{#Definition}}
          {{#Extended definition}}
            <div class="details-wrapper">
              <details class="modern-details">
                <summary class="modern-summary" tabindex="0">
                  <span>Extended Japanese Definition</span>
                  <span>▼</span>
                </summary>
                <div class="extended-def-content">
                  {{edit:Extended definition}}
                </div>
              </details>
            </div>
          {{/Extended definition}}
        {{/Definition}}

      </div> <!-- End side-content -->

    </div> <!-- End back-grid -->

    <!-- ==========================================
         FOOTER: Source Info
         ========================================== -->
    {{#Source}}
      <div class="source-footer">
        {{edit:Source}}
      </div>
    {{/Source}}

  </div> <!-- End card-container -->
</div>
