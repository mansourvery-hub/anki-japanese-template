<!-- BACK CARD TEMPLATE
     Premium Ergonomic Japanese Back Card
     
     Structure:
     - Sticky Tags Bar
     - 2-Column Desktop Grid / 1-Column Mobile Layout
     - Main: Word/Furigana, Frequency/Pitch, Circular Audio Buttons, Definition, Sentence & Translation
     - Side: Lightbox Picture, Kanji Notes, General Notes, Extended Definition
-->

<div class="card-wrapper">

  <!-- Sticky Tags Bar -->
  {{#Tags}}
    <div class="tags-container">
      <div class="tags-list"></div>
      <div class="tags-raw" style="display: none;">{{Tags}}</div>
      <script>
        (function() {
          const raw = document.querySelector('.tags-raw');
          const list = document.querySelector('.tags-list');
          if (raw && list && !list.hasChildNodes()) {
            const tags = raw.innerText.trim().split(/\s+/);
            tags.forEach(tag => {
              if (tag) {
                const span = document.createElement('span');
                span.className = 'tag-pill';
                span.innerText = tag;
                list.appendChild(span);
              }
            });
          }
        })();
      </script>
    </div>
  {{/Tags}}

  <div class="card-container">
    <div class="back-grid">
      
      <!-- MAIN COLUMN -->
      <div class="main-content">
        
        <!-- Word Header -->
        <div class="card-block word-header">
          
          <!-- Word Header (hidden entirely when the word fields are empty:
               audio-only / picture-only cards no longer show a padded void) -->
          {{#furigana}}
            <div class="word-display">
              {{edit:furigana:furigana}}
            </div>
          {{/furigana}}
          {{^furigana}}
            {{#Expression}}
              <div class="word-display">
                {{edit:furigana:Expression}}
              </div>
            {{/Expression}}
          {{/furigana}}

          <!-- Metadata & Circular Audio Controllers -->
          <div class="word-meta-row">
            {{#Frequency}}
              <div class="frequency-badge">
                {{edit:Frequency}}
              </div>
            {{/Frequency}}

            {{#Pitch Accent}}
              <div class="pitch-accent-badge">
                {{edit:Pitch Accent}}
              </div>
            {{/Pitch Accent}}

            <!-- Circular Audio Buttons with SVG Progress Ring -->
            <div class="audio-row">
              {{#Word Audio}}
                <button type="button" class="circular-audio-btn small-audio-btn" title="Play Word Audio" onclick="playCircularAudio(this)">
                  <svg class="audio-progress-ring" viewBox="0 0 44 44">
                    <circle class="ring-bg" cx="22" cy="22" r="19" />
                    <circle class="ring-fill" cx="22" cy="22" r="19" stroke-dasharray="119.38" stroke-dashoffset="119.38" />
                  </svg>
                  <div class="audio-btn-content">
                    <span class="audio-btn-label">言葉</span>
                  </div>
                  <div class="raw-audio-source" style="display:none;">{{Word Audio}}</div>
                </button>
              {{/Word Audio}}
              
              {{#Sentence Audio}}
                <button type="button" class="circular-audio-btn small-audio-btn" title="Play Sentence Audio" onclick="playCircularAudio(this)">
                  <svg class="audio-progress-ring" viewBox="0 0 44 44">
                    <circle class="ring-bg" cx="22" cy="22" r="19" />
                    <circle class="ring-fill" cx="22" cy="22" r="19" stroke-dasharray="119.38" stroke-dashoffset="119.38" />
                  </svg>
                  <div class="audio-btn-content">
                    <span class="audio-btn-label">文</span>
                  </div>
                  <div class="raw-audio-source" style="display:none;">{{Sentence Audio}}</div>
                </button>
              {{/Sentence Audio}}
            </div>
          </div>

          <!-- Main Definition (compact: see "Definition Compactor" CSS section) -->
          {{#Definition}}
            <div class="definition-box primary-definition">
              {{edit:furigana:Definition}}
            </div>
          {{/Definition}}

          <!-- Fallback: Show Extended definition if Definition is absent -->
          {{^Definition}}
            {{#Extended definition}}
              <div class="definition-box">
                {{Extended definition}}
              </div>
            {{/Extended definition}}
          {{/Definition}}
        </div>

        <!-- Sentence Block -->
        {{#Sentence}}
          <div class="card-block sentence-block">
            <div class="sentence-japanese">
              {{#Sentence (furigana)}}
                {{edit:furigana:Sentence (furigana)}}
              {{/Sentence (furigana)}}
              {{^Sentence (furigana)}}
                {{edit:Sentence}}
              {{/Sentence (furigana)}}
            </div>

            {{#Translation}}
              <div class="translation-box"
                   role="button"
                   tabindex="0"
                   aria-expanded="false"
                   onclick="this.classList.toggle('revealed'); this.setAttribute('aria-expanded', this.classList.contains('revealed'))"
                   onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();this.click()}">
                <div class="translation-hint">👁️ Translation</div>
                <div class="translation-text">{{edit:Translation}}</div>
              </div>
            {{/Translation}}

            {{#context}}
              <div class="context-block">
                <div class="html-content">{{edit:context}}</div>
              </div>
            {{/context}}
          </div>
        {{/Sentence}}

        <!-- Orphan Translation / Context (When Sentence is empty) -->
        {{^Sentence}}
          {{#Translation}}
            <div class="card-block">
              <div class="translation-text" style="display: block;">{{edit:Translation}}</div>
            </div>
          {{/Translation}}

          {{#context}}
            <div class="card-block">
              <div class="html-content">{{edit:context}}</div>
            </div>
          {{/context}}
        {{/Sentence}}

      </div> <!-- End main-content -->

      <!-- SIDE COLUMN -->
      <div class="side-content">
         
        <!-- Picture Block (Click to Expand Lightbox) -->
        {{#Picture}}
          <div class="card-block picture-block">
            <div class="picture-container" onclick="openLightbox(this)">
              {{Picture}}
            </div>
          </div>
        {{/Picture}}

        <!-- Kanji Notes -->
        {{#Kanji Notes}}
          <div class="card-block">
            <div class="html-content">{{edit:Kanji Notes}}</div>
          </div>
        {{/Kanji Notes}}

        <!-- General Notes -->
        {{#Notes}}
          <div class="card-block">
            <div class="html-content">{{edit:furigana:Notes}}</div>
          </div>
        {{/Notes}}

        <!-- Extended Definition Accordion (Only when standard Definition also exists) -->
        {{#Definition}}
          {{#Extended definition}}
            <div class="details-wrapper">
              <details class="modern-details">
                <summary class="modern-summary" tabindex="0">
                  <span>Extended Definition</span>
                  <span>▼</span>
                </summary>
                <div class="extended-def-content">
                  {{Extended definition}}
                </div>
              </details>
            </div>
          {{/Extended definition}}
        {{/Definition}}

      </div> <!-- End side-content -->

    </div> <!-- End back-grid -->

    <!-- Footer -->
    {{#Source}}
      <div class="source-footer">
        {{edit:Source}}
      </div>
    {{/Source}}

  </div> <!-- End card-container -->
</div>

<!-- Lightbox, Auto-Scaling & Audio Scripts -->
<script>
  (function() {
    /* Dynamic Font Scaling for Sentence Display on Back */
    /* Font size scales with text length; line-height always reserves exact
       furigana headroom (rt 0.55em + 2px gap) so hover furigana on any
       wrapped line never overlaps the line above. */
    function autoScaleBackSentence() {
      const sentences = document.querySelectorAll('.sentence-japanese');
      sentences.forEach(el => {
        const text = el.innerText ? el.innerText.trim() : '';
        const len = text.length;
        if (len === 0) return;

        if (len <= 10) {
          el.style.fontSize = 'clamp(2.8rem, 6.5vw, 4.5rem)';
        } else if (len <= 22) {
          el.style.fontSize = 'clamp(2.2rem, 5vw, 3.5rem)';
        } else if (len <= 40) {
          el.style.fontSize = 'clamp(1.8rem, 4vw, 2.8rem)';
        } else {
          el.style.fontSize = 'clamp(1.5rem, 3.2vw, 2.2rem)';
        }
        /* line-height intentionally NOT set here: the stylesheet's
           calc((0.55em + 2px) + 1em) reserves the exact furigana headroom
           against this dynamically scaled font size — no overlap, no waste */
      });
    }

    autoScaleBackSentence();

    /* --- ZOOMABLE LIGHTBOX CONTROLLER --- */
    /* Desktop: wheel-zoom toward cursor, drag-to-pan. Click closes at 1x;
       when zoomed only the backdrop (outside the image) closes; Esc always.
       Mobile: pinch-zoom, double-tap toggles 1x<->2.5x, one-finger pan.
       Scale clamp 1..5; touch gestures never scroll the card behind. */
    window.openLightbox = function(target) {
      const img = target.querySelector('img') || (target.tagName === 'IMG' ? target : null);
      if (!img) return;
      if (document.querySelector('.lightbox-overlay')) return;

      const overlay = document.createElement('div');
      overlay.className = 'lightbox-overlay';

      const clone = document.createElement('img');
      clone.src = img.src;
      clone.className = 'expanded-img';

      overlay.appendChild(clone);
      document.body.appendChild(overlay);

      /* --- zoom state (tx/ty = pan, s = scale) --- */
      let s = 1, tx = 0, ty = 0;
      let dragging = false, moved = false;
      let lastX = 0, lastY = 0;
      let pinchDist = 0, pinchScale = 1;
      let lastTap = 0;

      const MIN_S = 1, MAX_S = 5, DBL_S = 2.5, DRAG_T = 5;

      const apply = () => {
        clone.style.transform =
          'translate(-50%, -50%) translate(' + tx + 'px, ' + ty + 'px) scale(' + s + ')';
        overlay.style.cursor = s > 1 ? 'default' : 'zoom-out';
        clone.style.cursor = s > 1 ? (dragging ? 'grabbing' : 'grab') : 'zoom-out';
      };
      apply();

      /* Zoom anchored at viewport point (px,py) so that point stays fixed */
      const zoomAt = (px, py, ns) => {
        /* first gesture: freeze entrance animation so its transform stops
           fighting the inline zoom transform */
        if (!overlay.classList.contains('is-zooming')) {
          overlay.classList.add('is-zooming');
        }
        ns = Math.min(Math.max(ns, MIN_S), MAX_S);
        const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
        const dx = px - cx, dy = py - cy;
        tx = dx - (dx - tx) * (ns / s);
        ty = dy - (dy - ty) * (ns / s);
        s = ns;
        if (s === 1) { tx = 0; ty = 0; }
        apply();
      };

      /* --- close --- */
      const closeOverlay = () => {
        dragging = false;
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        document.removeEventListener('keydown', handleKey);
      };
      const handleKey = (e) => { if (e.key === 'Escape') closeOverlay(); };
      document.addEventListener('keydown', handleKey);

      /* --- desktop: wheel zoom toward cursor --- */
      overlay.addEventListener('wheel', (e) => {
        e.preventDefault();
        zoomAt(e.clientX, e.clientY, s * (e.deltaY < 0 ? 1.15 : 1 / 1.15));
      }, { passive: false });

      /* --- pan (mouse & touch share the math) --- */
      const panStart = (x, y) => {
        dragging = true; moved = false;
        lastX = x; lastY = y;
      };
      const panMove = (x, y) => {
        if (!dragging) return;
        if (Math.abs(x - lastX) + Math.abs(y - lastY) > DRAG_T) moved = true;
        if (s > 1) {
          tx += x - lastX;
          ty += y - lastY;
          apply();
        }
        lastX = x; lastY = y;
      };

      /* --- mouse: drag pans; clean click closes at 1x, or on backdrop
             (outside the image) even when zoomed --- */
      overlay.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        e.preventDefault();
        panStart(e.clientX, e.clientY);
        const mm = (ev) => panMove(ev.clientX, ev.clientY);
        const mu = (ev) => {
          panEnd(ev);
          window.removeEventListener('mousemove', mm);
          window.removeEventListener('mouseup', mu);
        };
        window.addEventListener('mousemove', mm);
        window.addEventListener('mouseup', mu);
      });
      const panEnd = (ev) => {
        dragging = false;
        if (!moved && (s === 1 || ev.target === overlay)) closeOverlay();
        apply();
      };

      /* --- touch: pinch / double-tap / one-finger pan --- */
      const t0xy = (e) => [e.touches[0].clientX, e.touches[0].clientY];
      overlay.addEventListener('touchstart', (e) => {
        if (e.touches.length === 2) {
          dragging = false;
          pinchDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY);
          pinchScale = s;
        } else if (e.touches.length === 1) {
          const now = Date.now();
          if (now - lastTap < 300) {
            e.preventDefault(); /* stop synthetic dblclick / browser zoom */
            const t = e.touches[0];
            zoomAt(t.clientX, t.clientY, s > 1 ? 1 : DBL_S);
            lastTap = 0;
          } else {
            lastTap = now;
            const [x, y] = t0xy(e);
            panStart(x, y);
          }
        }
      }, { passive: false });
      overlay.addEventListener('touchmove', (e) => {
        /* fullscreen modal: never let the card scroll behind it */
        e.preventDefault();
        if (e.touches.length === 2 && pinchDist) {
          const d = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY);
          const cx = (e.touches[0].clientX + e.touches[1].clientX) / 2;
          const cy = (e.touches[0].clientY + e.touches[1].clientY) / 2;
          zoomAt(cx, cy, pinchScale * d / pinchDist);
          moved = true;
        } else if (e.touches.length === 1 && dragging) {
          const [x, y] = t0xy(e);
          panMove(x, y);
        }
      }, { passive: false });
      overlay.addEventListener('touchend', (e) => {
        if (e.touches.length === 0) {
          pinchDist = 0;
          if (!moved && (s === 1 || e.target === overlay)) closeOverlay();
          dragging = false;
        } else if (e.touches.length === 1) {
          pinchDist = 0;
        }
      }, { passive: true });
    };

    /* --- CIRCULAR AUDIO CONTROLLER --- */
    window.currentActiveAudio = window.currentActiveAudio || null;
    window.currentActiveBtn = window.currentActiveBtn || null;

    window.playCircularAudio = function(btn) {
      const ringFill = btn.querySelector('.ring-fill');
      const circumference = ringFill ? parseFloat(ringFill.getAttribute('stroke-dasharray')) : 119.38;

      if (window.currentActiveBtn === btn && window.currentActiveAudio && !window.currentActiveAudio.paused) {
        window.currentActiveAudio.pause();
        btn.classList.remove('is-playing');
        btn.classList.add('is-paused');
        return;
      }

      if (window.currentActiveAudio) {
        window.currentActiveAudio.pause();
        if (window.currentActiveBtn) {
          window.currentActiveBtn.classList.remove('is-playing', 'is-paused');
          const oldFill = window.currentActiveBtn.querySelector('.ring-fill');
          if (oldFill) {
            const oldCirc = parseFloat(oldFill.getAttribute('stroke-dasharray')) || 119.38;
            oldFill.style.strokeDashoffset = oldCirc;
          }
        }
      }

      const rawDiv = btn.querySelector('.raw-audio-source');
      let audioSrc = '';
      if (rawDiv) {
        const match = rawDiv.innerHTML.match(/(?:src=["']|sound:)([^"'>\s]+)/i);
        if (match) audioSrc = match[1];
      }

      const nativeReplay = btn.querySelector('.replaybutton, .replay-button, a.sound, .soundLink');

      if (!audioSrc) {
        if (nativeReplay) nativeReplay.click();
        return;
      }

      const audio = new Audio(audioSrc);
      window.currentActiveAudio = audio;
      window.currentActiveBtn = btn;

      btn.classList.remove('is-paused');
      btn.classList.add('is-playing');

      audio.play().catch(() => {
        if (nativeReplay) nativeReplay.click();
      });

      const updateProgress = () => {
        if (window.currentActiveAudio === audio && !audio.paused && audio.duration) {
          const progress = audio.currentTime / audio.duration;
          if (ringFill) {
            ringFill.style.strokeDashoffset = circumference * (1 - Math.min(Math.max(progress, 0), 1));
          }
          requestAnimationFrame(updateProgress);
        }
      };
      requestAnimationFrame(updateProgress);

      audio.onended = () => {
        btn.classList.remove('is-playing', 'is-paused');
        if (ringFill) ringFill.style.strokeDashoffset = circumference;
        window.currentActiveAudio = null;
        window.currentActiveBtn = null;
      };
    };
  })();
</script>
